<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lumos" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
        <item name="android:statusBarColor">@color/launcher_background</item>
    </style>

    <style name="Theme.Lumos.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_lumos_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Lumos</item>
    </style>
</resources>
